  "name": "临",
  "full_name": "地泽临",
  "pattern": "110000",
  "lower": "兑",
  "upper": "坤",
  "judgement": "元亨。利貞。至于八月有凶。",
  "lines": [
    {
      "label": "初九",
      "text": "咸臨，貞吉。"
    },
    {
      "label": "九二",
      "text": "咸臨，吉无不利。"
    },
    {
      "label": "六三",
      "text": "甘臨，无攸利。既憂之，无咎。"
    },
    {
      "label": "六四",
      "text": "至臨，无咎。"
    },
    {
      "label": "六五",
      "text": "知臨，大君之宜，吉。"
    },
    {
      "label": "上六",
      "text": "敦臨，吉无咎。"
    }
  ],
  "special": [],
  "image": "澤上有地，臨；君子以教思无窮，容保民无疆。",
