  "judgement": "亨。利貞。取女吉。",
  "lines": [
    {
      "label": "初六",
      "text": "咸其拇（异文：母）。"
    },
    {
      "label": "六二",
      "text": "咸其腓，凶，居吉。"
    },
    {
      "label": "九三",
      "text": "咸其股，執其隨，往吝。"
    },
    {
      "label": "九四",
      "text": "貞吉悔亡，憧憧往來，朋從爾思。"
    },
    {
      "label": "九五",
      "text": "咸其脢，无悔。"
    },
    {
      "label": "上六",
      "text": "咸其輔，頰，舌。"
    }
  ],
