{
  "number": 37,
  "name": "家人",
  "full_name": "风火家人",
  "pattern": "101011",
  "lower": "离",
  "upper": "巽",
  "judgement": "利女貞。",
  "lines": [
    {
      "label": "初九",
      "text": "閑有家，悔亡。"
    },
    {
      "label": "六二",
      "text": "无攸遂，在中饋，貞吉。"
    },
    {
      "label": "九三",
      "text": "家人嗃嗃，悔厲吉；婦子嘻嘻，終吝。"
    },
    {
      "label": "六四",
      "text": "富家，大吉。"
    },
    {
      "label": "九五",
      "text": "王假有家，勿恤。吉。"
    },
    {
      "label": "上九",
      "text": "有孚威如，終吉。"
    }
  ],
  "special": [],
  "image": "風自火出，家人；君子以言有物，而行有恆。",
