{
  "number": 28,
  "name": "大过",
  "full_name": "泽风大过",
  "pattern": "011110",
  "lower": "巽",
  "upper": "兑",
  "judgement": "棟橈，利有攸往，亨。",
  "lines": [
    {
      "label": "初六",
      "text": "藉用白茅，无咎。"
    },
    {
      "label": "九二",
      "text": "枯楊生稊，老夫得其女妻，无不利。"
    },
    {
      "label": "九三",
      "text": "棟橈，凶。"
    },
    {
      "label": "九四",
      "text": "棟隆，吉。有它吝。"
    },
    {
      "label": "九五",
      "text": "枯楊生華，老婦得其士夫，无咎无譽。"
    },
    {
      "label": "上六",
      "text": "過涉滅頂，凶，无咎。"
    }
  ],
  "special": [],
  "image": "澤滅木，大過。君子以獨立不懼，遯世无悶。",
