  "judgement": "亨。苦節不可貞。",
  "lines": [
    {
      "label": "初九",
      "text": "不出戶庭，无咎。"
    },
    {
      "label": "九二",
      "text": "不出門庭，凶。"
    },
    {
      "label": "六三",
      "text": "不節若，則嗟若，无咎。"
    },
    {
      "label": "六四",
      "text": "安節，亨。"
    },
    {
      "label": "九五",
      "text": "甘節，吉；往有尚。"
    },
    {
      "label": "上六",
      "text": "苦節，貞凶，悔亡。"
    }
  ],
