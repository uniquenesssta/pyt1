  "judgement": "盥而不薦，有孚顒若。",
  "lines": [
    {
      "label": "初六",
      "text": "童觀，小人无咎，君子吝。"
    },
    {
      "label": "六二",
      "text": "窺觀，利女貞。"
    },
    {
      "label": "六三",
      "text": "觀我生，進退。"
    },
    {
      "label": "六四",
      "text": "觀國之光，利用賓于王。"
    },
    {
      "label": "九五",
      "text": "觀我生，君子无咎。"
    },
    {
      "label": "上九",
      "text": "觀其生，君子无咎。"
    }
  ],
