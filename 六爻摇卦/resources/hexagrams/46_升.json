  "upper": "坤",
  "judgement": "元亨，用見大人，勿恤，南征吉。",
  "lines": [
    {
      "label": "初六",
      "text": "允升，大吉。"
    },
    {
      "label": "九二",
      "text": "孚乃利用禴，无咎。"
    },
    {
      "label": "九三",
      "text": "升虛邑。"
    },
    {
      "label": "六四",
      "text": "王用享（异文：亨）于岐山，吉无咎。"
    },
    {
      "label": "六五",
      "text": "貞吉，升階。"
    },
    {
      "label": "上六",
      "text": "冥升，利于不息之貞。"
    }
  ],
