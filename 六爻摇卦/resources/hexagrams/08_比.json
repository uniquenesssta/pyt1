{
  "number": 8,
  "name": "比",
  "full_name": "水地比",
  "pattern": "000010",
  "lower": "坤",
  "upper": "坎",
  "judgement": "吉。原筮元永貞，无咎。不寧方來，後夫凶。",
  "lines": [
    {
      "label": "初六",
      "text": "有孚，比之，无咎。有孚盈缶，終來有它，吉。"
    },
    {
      "label": "六二",
      "text": "比之自內，貞吉。"
    },
    {
      "label": "六三",
      "text": "比之匪人。"
    },
    {
      "label": "六四",
      "text": "外比之，貞吉。"
    },
    {
      "label": "九五",
      "text": "顯比。王用三敺（异文：驅），失前禽，邑人不誡，吉。"
    },
    {
      "label": "上六",
      "text": "比之无首，凶。"
    }
  ],
