{
  "number": 27,
  "name": "颐",
  "full_name": "山雷颐",
  "pattern": "100001",
  "lower": "震",
  "upper": "艮",
  "judgement": "貞吉。觀頤，自求口實。",
  "lines": [
    {
      "label": "初九",
      "text": "舍爾靈龜，觀我朵頤，凶。"
    },
    {
      "label": "六二",
      "text": "顛頤，拂經，于丘頤，征凶。"
    },
    {
      "label": "六三",
      "text": "拂頤，貞凶，十年勿用，无攸利。"
    },
    {
      "label": "六四",
      "text": "顛頤吉，虎視眈眈，其欲逐逐，无咎。"
    },
    {
      "label": "六五",
      "text": "拂經，居貞吉，不可涉大川。"
    },
    {
      "label": "上九",
      "text": "由頤，厲吉，利涉大川。"
    }
  ],
  "special": [],
  "image": "山下有雷，頤；君子以慎言語，節飲食。",
