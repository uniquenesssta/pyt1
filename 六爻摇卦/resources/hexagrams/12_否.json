{
  "number": 12,
  "name": "否",
  "full_name": "天地否",
  "pattern": "000111",
  "lower": "坤",
  "upper": "乾",
  "judgement": "否之匪人，不利君子貞，大往小來。",
  "lines": [
    {
      "label": "初六",
      "text": "拔茅茹以其彙，貞吉。亨。"
    },
    {
      "label": "六二",
      "text": "包承，小人吉，大人否。亨。"
    },
    {
      "label": "六三",
      "text": "包羞。"
    },
    {
      "label": "九四",
      "text": "有命，无咎，疇離祉。"
    },
    {
      "label": "九五",
      "text": "休否，大人吉。其亡其亡，繫于包（异文：苞）桑。"
    },
    {
      "label": "上九",
      "text": "傾否，先否後喜。"
    }
  ],
  "special": [],
  "image": "天地不交，否；君子以儉德辟難，不可榮以祿。",
