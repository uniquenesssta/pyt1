{
  "number": 9,
  "name": "小畜",
  "full_name": "风天小畜",
  "pattern": "111011",
  "lower": "乾",
  "upper": "巽",
  "judgement": "亨。密雲不雨，自我西郊。",
  "lines": [
    {
      "label": "初九",
      "text": "復自道，何其咎，吉。"
    },
    {
      "label": "九二",
      "text": "牽復，吉。"
    },
    {
      "label": "九三",
      "text": "車（异文：輿）說輹（异文：輻），夫妻反目。"
    },
    {
      "label": "六四",
      "text": "有孚，血去惕出，无咎。"
    },
    {
      "label": "九五",
      "text": "有孚攣如，富以其鄰。"
    },
    {
      "label": "上九",
      "text": "既雨既處，尚得（异文：德）載，婦貞厲，月幾望，君子征凶。"
    }
  ],
