{
  "number": 26,
  "name": "大畜",
  "full_name": "山天大畜",
  "pattern": "111001",
  "lower": "乾",
  "upper": "艮",
  "judgement": "利貞，不家食吉，利涉大川。",
  "lines": [
    {
      "label": "初九",
      "text": "有厲利已。"
    },
    {
      "label": "九二",
      "text": "輿說輹（异文：腹）。"
    },
    {
      "label": "九三",
      "text": "良馬逐，利艱貞，吉。日閑輿衛，利有攸往。"
    },
    {
      "label": "六四",
      "text": "童牛之告（异文：牿），元吉。"
    },
    {
      "label": "六五",
      "text": "豶豕之牙，吉。"
    },
    {
      "label": "上九",
      "text": "何天之衢，亨。"
    }
  ],
  "special": [],
  "image": "天在山中，大畜；君子以多識前言往行，以畜其德。",
