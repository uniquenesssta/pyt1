{
  "number": 34,
  "name": "大壮",
  "full_name": "雷天大壮",
  "pattern": "111100",
  "lower": "乾",
  "upper": "震",
  "judgement": "利貞。",
  "lines": [
    {
      "label": "初九",
      "text": "壯于趾，征凶，有孚。"
    },
    {
      "label": "九二",
      "text": "貞吉。"
    },
    {
      "label": "九三",
      "text": "小人用壯，君子用罔，貞厲。羝羊觸藩，羸其角。"
    },
    {
      "label": "九四",
      "text": "貞吉悔亡，藩決不羸，壯于大轝（异文：輿）之腹（异文：輹）。"
    },
    {
      "label": "六五",
      "text": "喪羊于易，无悔。"
    },
    {
      "label": "上六",
      "text": "羝羊觸藩，不能退，不能遂，无攸利，艱則吉。"
    }
  ],
  "special": [],
  "image": "雷在天上，大壯；君子以非禮弗履。",
