{
  "number": 24,
  "name": "复",
  "full_name": "地雷复",
  "pattern": "100000",
  "lower": "震",
  "upper": "坤",
  "judgement": "亨。出入无疾，朋來无咎。反復其道，七日來復，利有攸往。",
  "lines": [
    {
      "label": "初九",
      "text": "不遠復，无祇悔，元吉。"
    },
    {
      "label": "六二",
      "text": "休復，吉。"
    },
    {
      "label": "六三",
      "text": "頻復，厲无咎。"
    },
    {
      "label": "六四",
      "text": "中行獨復。"
    },
    {
      "label": "六五",
      "text": "敦復，无悔。"
    },
    {
      "label": "上六",
      "text": "迷復，凶，有災眚。用行師，終有大敗，以其國君，凶；至于十年，不克征。"
    }
  ],
  "special": [],
  "image": "雷在地中，復；先王以至日閉關，商旅不行，后不省方。",
