  "full_name": "雷风恒",
  "pattern": "011100",
  "lower": "巽",
  "upper": "震",
  "judgement": "恆：亨，无咎。利貞，利有攸往。",
  "lines": [
    {
      "label": "初六",
      "text": "浚恆，貞凶，无攸利。"
    },
    {
      "label": "九二",
      "text": "悔亡。"
    },
    {
      "label": "九三",
      "text": "不恆其德，或承之羞，貞吝。"
    },
    {
      "label": "九四",
      "text": "田无禽。"
    },
    {
      "label": "六五",
      "text": "恆其德，貞，婦人吉，夫子凶。"
    },
    {
      "label": "上六",
      "text": "震（异文：振）恆，凶。"
    }
  ],
