{
  "number": 7,
  "name": "师",
  "full_name": "地水师",
  "pattern": "010000",
  "lower": "坎",
  "upper": "坤",
  "judgement": "貞丈人吉，无咎。",
  "lines": [
    {
      "label": "初六",
      "text": "師出以律，否臧，凶。"
    },
    {
      "label": "九二",
      "text": "在師中吉，无咎；王三錫命。"
    },
    {
      "label": "六三",
      "text": "師或輿尸，凶。"
    },
    {
      "label": "六四",
      "text": "師左次，无咎。"
    },
    {
      "label": "六五",
      "text": "田有禽，利執言，无咎。長子帥師，弟子輿尸，貞凶。"
    },
    {
      "label": "上六",
      "text": "大君有命，開國承家，小人勿用。"
    }
  ],
  "special": [],
  "image": "地中有水，師；君子以容民畜衆。",
