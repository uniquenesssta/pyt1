{
  "number": 14,
  "name": "大有",
  "full_name": "火天大有",
  "pattern": "111101",
  "lower": "乾",
  "upper": "离",
  "judgement": "元亨。",
  "lines": [
    {
      "label": "初九",
      "text": "无交害，匪咎，艱則无咎。"
    },
    {
      "label": "九二",
      "text": "大轝（异文：車）以載，有攸往，无咎。"
    },
    {
      "label": "九三",
      "text": "公用亨于天子，小人弗克。"
    },
    {
      "label": "九四",
      "text": "匪其尫（异文：彭），无咎。"
    },
    {
      "label": "六五",
      "text": "厥孚交如，威如；吉。"
    },
    {
      "label": "上九",
      "text": "自天佑（异文：右）之，吉无不利。"
    }
  ],
  "special": [],
  "image": "火在天上，大有；君子以遏惡揚善，順天休命。",
