{
  "number": 48,
  "name": "井",
  "full_name": "水风井",
  "pattern": "011010",
  "lower": "巽",
  "upper": "坎",
  "judgement": "改邑不改井，无喪无得，往來井井。汔至亦未繘井。羸其瓶，凶。",
  "lines": [
    {
      "label": "初六",
      "text": "井泥不食，舊井无禽。"
    },
    {
      "label": "九二",
      "text": "井谷射鮒，瓮敝漏。"
    },
    {
      "label": "九三",
      "text": "井渫不食，為我心惻，可用汲，王明，並受其福。"
    },
    {
      "label": "六四",
      "text": "井甃，无咎。"
    },
    {
      "label": "九五",
      "text": "井冽，寒泉食。"
    },
    {
      "label": "上六",
      "text": "井收勿幕，有孚元吉。"
    }
  ],
  "special": [],
  "image": "木上有水，井；君子以勞民勸相。",
