{
  "number": 49,
  "name": "革",
  "full_name": "泽火革",
  "pattern": "101110",
  "lower": "离",
  "upper": "兑",
  "judgement": "已日乃孚，元亨。利貞。悔亡。",
  "lines": [
    {
      "label": "初九",
      "text": "鞏用黃牛之革。"
    },
    {
      "label": "六二",
      "text": "已日乃革之，征吉，无咎。"
    },
    {
      "label": "九三",
      "text": "征凶，貞厲，革言三就，有孚。"
    },
    {
      "label": "九四",
      "text": "悔亡，有孚改命，吉。"
    },
    {
      "label": "九五",
      "text": "大人虎變，未占有孚。"
    },
    {
      "label": "上六",
      "text": "君子豹變，小人革面，征凶，居貞吉。"
    }
  ],
  "special": [],
  "image": "澤中有火，革；君子以治歷明時。",
