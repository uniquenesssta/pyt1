  "judgement": "亨，王假有廟，利涉大川，利貞。",
  "lines": [
    {
      "label": "初六",
      "text": "用拯馬壯，吉，悔亡。"
    },
    {
      "label": "九二",
      "text": "渙奔其机，悔亡。"
    },
    {
      "label": "六三",
      "text": "渙其躬，无悔。"
    },
    {
      "label": "六四",
      "text": "渙其群，元吉。渙有丘，匪夷所思。"
    },
    {
      "label": "九五",
      "text": "渙汗其大號，渙王居，无咎。"
    },
    {
      "label": "上九",
      "text": "渙其血，去逖出，无咎。"
    }
  ],
