{
  "number": 30,
  "name": "离",
  "full_name": "离为火",
  "pattern": "101101",
  "lower": "离",
  "upper": "离",
  "judgement": "利貞。亨。畜牝牛，吉。",
  "lines": [
    {
      "label": "初九",
      "text": "履錯然，敬之无咎。"
    },
    {
      "label": "六二",
      "text": "黃離，元吉。"
    },
    {
      "label": "九三",
      "text": "日昃之離，不鼓缶而歌，則大耋之差（异文：嗟），凶。"
    },
    {
      "label": "九四",
      "text": "突如其來如，焚如，死如，棄如。"
    },
    {
      "label": "六五",
      "text": "出涕沱若，戚嗟若，吉。"
    },
    {
      "label": "上九",
      "text": "王用出征，有嘉折首，獲匪其醜，无咎。"
    }
  ],
