{
  "number": 22,
  "name": "贲",
  "full_name": "山火贲",
  "pattern": "101001",
  "lower": "离",
  "upper": "艮",
  "judgement": "亨。小利有攸往。",
  "lines": [
    {
      "label": "初九",
      "text": "賁其趾，舍車而徒。"
    },
    {
      "label": "六二",
      "text": "賁其須。"
    },
    {
      "label": "九三",
      "text": "賁如濡如，永貞吉。"
    },
    {
      "label": "六四",
      "text": "賁如皤如，白馬翰如，匪寇婚媾。"
    },
    {
      "label": "六五",
      "text": "賁於丘園，束帛戔戔，吝，終吉。"
    },
    {
      "label": "上九",
      "text": "白賁，无咎。"
    }
  ],
  "special": [],
  "image": "山下有火，賁；君子以明庶政，无敢折獄。",
