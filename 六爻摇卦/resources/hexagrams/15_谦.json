{
  "number": 15,
  "name": "谦",
  "full_name": "地山谦",
  "pattern": "001000",
  "lower": "艮",
  "upper": "坤",
  "judgement": "亨，君子有終。",
  "lines": [
    {
      "label": "初六",
      "text": "謙謙君子，用涉大川，吉。"
    },
    {
      "label": "六二",
      "text": "鳴謙，貞吉。"
    },
    {
      "label": "九三",
      "text": "勞謙君子，有終吉。"
    },
    {
      "label": "六四",
      "text": "无不利，撝謙。"
    },
    {
      "label": "六五",
      "text": "不富，以其鄰，利用侵伐，无不利。"
    },
    {
      "label": "上六",
      "text": "鳴謙，利用行師，征邑國。"
    }
  ],
  "special": [],
  "image": "地中有山，謙；君子以裒多益寡，稱物平施。",
