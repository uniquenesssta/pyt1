{
  "number": 18,
  "name": "蛊",
  "full_name": "山风蛊",
  "pattern": "011001",
  "lower": "巽",
  "upper": "艮",
  "judgement": "元亨。利涉大川。先甲三日，後甲三日。",
  "lines": [
    {
      "label": "初六",
      "text": "幹父之蠱，有子考，无咎，厲終吉。"
    },
    {
      "label": "九二",
      "text": "幹母之蠱，不可貞。"
    },
    {
      "label": "九三",
      "text": "幹父之蠱，小有悔，无大咎。"
    },
    {
      "label": "六四",
      "text": "裕父之蠱，往見吝。"
    },
    {
      "label": "六五",
      "text": "幹父之蠱，用譽。"
    },
    {
      "label": "上九",
      "text": "不事王侯，高尚其事。"
    }
  ],
  "special": [],
  "image": "山下有風，蠱；君子以振民育德。",
