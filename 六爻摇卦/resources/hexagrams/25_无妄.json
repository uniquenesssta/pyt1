{
  "number": 25,
  "name": "无妄",
  "full_name": "天雷无妄",
  "pattern": "100111",
  "lower": "震",
  "upper": "乾",
  "judgement": "元亨。利貞。其匪正有眚，不利有攸往。",
  "lines": [
    {
      "label": "初九",
      "text": "无妄，往吉。"
    },
    {
      "label": "六二",
      "text": "不耕穫，不菑畬，則利有攸往。"
    },
    {
      "label": "六三",
      "text": "无妄之災，或繫之牛，行人之得，邑人之災。"
    },
    {
      "label": "九四",
      "text": "可貞，无咎。"
    },
    {
      "label": "九五",
      "text": "无妄之疾，勿藥有喜。"
    },
    {
      "label": "上九",
      "text": "无妄，行有眚，无攸利。"
    }
  ],
