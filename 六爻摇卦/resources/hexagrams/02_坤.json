  "upper": "坤",
  "judgement": "元亨。利牝馬之貞。君子有攸往，先迷後得主。利西南得朋，東北喪朋。安貞，吉。",
  "lines": [
    {
      "label": "初六",
      "text": "履霜，堅冰至。"
    },
    {
      "label": "六二",
      "text": "直方大，不習无不利。"
    },
    {
      "label": "六三",
      "text": "含章，可貞。或從王事，无成有終。"
    },
    {
      "label": "六四",
      "text": "括囊，无咎无譽。"
    },
    {
      "label": "六五",
      "text": "黃裳，元吉。"
    },
    {
      "label": "上六",
      "text": "龍戰于野，其血玄黃。"
    }
  ],
  "special": [
    {
      "label": "用六",
      "text": "利永貞。"
    }
