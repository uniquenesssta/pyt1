{
  "number": 1,
  "name": "乾",
  "full_name": "乾为天",
  "pattern": "111111",
  "lower": "乾",
  "upper": "乾",
  "judgement": "元亨。利貞。",
  "lines": [
    {
      "label": "初九",
      "text": "潛龍勿用。"
    },
    {
      "label": "九二",
      "text": "見龍在田，利見大人。"
    },
    {
      "label": "九三",
      "text": "君子終日乾乾，夕惕若；厲，无咎。"
    },
    {
      "label": "九四",
      "text": "或躍在淵，无咎。"
    },
    {
      "label": "九五",
      "text": "飛龍在天，利見大人。"
    },
    {
      "label": "上九",
      "text": "亢龍，有悔。"
    }
  ],
  "special": [
    {
      "label": "用九",
      "text": "見羣龍无首，吉。"
    }
  ],
  "image": "天行健，君子以自強不息。",
